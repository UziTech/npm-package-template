{
  "name": "npm-package-template",
  "version": "0.1.0",
  "description": "NPM Package Template",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test spec/**/*.test.ts",
    "test:cover": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 spec/**/*.test.ts",
    "lint": "eslint",
    "format": "eslint --fix",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UziTech/npm-package-template.git"
  },
